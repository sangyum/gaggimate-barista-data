{
  "label": "Manzanita Colombia Bloom Slide [AI]",
  "type": "pro",
  "description": "Med washed Colombia Community Lot. Grape, apple & nougat. 18g in / 41g out. DF64 @ 11 (day 1). Bloom + slide to open fruit notes.",
  "temperature": 93,
  "phases": [
    {
      "name": "Fill",
      "phase": "preinfusion",
      "valve": 1,
      "duration": 5,
      "temperature": 0,
      "transition": { "type": "instant", "duration": 0, "adaptive": true },
      "pump": { "target": "flow", "pressure": 2, "flow": 2 }
    },
    {
      "name": "Bloom",
      "phase": "preinfusion",
      "valve": 1,
      "duration": 10,
      "temperature": 0,
      "transition": { "type": "instant", "duration": 0, "adaptive": true },
      "pump": { "target": "flow", "pressure": 0, "flow": 0 }
    },
    {
      "name": "Ramp",
      "phase": "brew",
      "valve": 1,
      "duration": 5,
      "temperature": 0,
      "transition": { "type": "linear", "duration": 4, "adaptive": true },
      "pump": { "target": "pressure", "pressure": 8.5, "flow": 0 },
      "targets": [{ "type": "pressure", "operator": "gte", "value": 8.5 }]
    },
    {
      "name": "Peak",
      "phase": "brew",
      "valve": 1,
      "duration": 6,
      "temperature": 0,
      "transition": { "type": "instant", "duration": 0, "adaptive": true },
      "pump": { "target": "pressure", "pressure": 8.5, "flow": 0 }
    },
    {
      "name": "Slide",
      "phase": "brew",
      "valve": 1,
      "duration": 50,
      "temperature": 0,
      "transition": { "type": "linear", "duration": 35, "adaptive": true },
      "pump": { "target": "pressure", "pressure": 5.5, "flow": 0 },
      "targets": [
        { "type": "volumetric", "operator": "gte", "value": 41 },
        { "type": "pumped", "operator": "gte", "value": 75 }
      ]
    }
  ]
}
